# ── Discord ─────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands in one guild only (they appear instantly).
# Leave blank to register globally (can take up to an hour to show up).
DISCORD_GUILD_ID=

# ── Claude subscription auth ────────────────────────────────────────────────
# Generate with:  claude setup-token
# Requires a Claude Pro/Max plan. Valid for one year. This is what makes the
# bot bill against your subscription instead of a pay-per-token API key.
CLAUDE_CODE_OAUTH_TOKEN=

# ── Access control ──────────────────────────────────────────────────────────
# Your own Discord user ID. Can approve any tool request in any thread.
OPERATOR_USER_ID=
# Comma-separated Discord user IDs allowed to command the bot.
# Anyone not listed here is refused — except the Operator, who is always
# allowed automatically (leave blank for an operator-only bot). Keep this to
# your internal team: sharing subscription rate limits with outside users is
# not permitted.
ALLOWED_USER_IDS=

# ── Agent defaults ──────────────────────────────────────────────────────────
# Folder the agent works in when /task or /schedule create is given no path
# (/ask has no path option and always uses this). `npm run workspace:init`
# scaffolds the content pipeline here too (ADR 0007), so pipeline commands
# need no `path:`. Must be OUTSIDE this repo.
DEFAULT_WORKSPACE=~/Desktop/marketing-workspace
# sonnet | opus | haiku
DEFAULT_MODEL=sonnet

# ── Optional tuning ─────────────────────────────────────────────────────────
# Extra shell commands to auto-approve, comma-separated command prefixes.
# Example: make test,poetry run pytest
EXTRA_BASH_ALLOW=
# How long an approval prompt waits before auto-denying (default 10 minutes).
APPROVAL_TIMEOUT_MS=600000
# Idle time before a session's Claude Code subprocess is shut down (default 30
# minutes). Thread context survives — the next message in the thread resumes it.
SESSION_IDLE_TIMEOUT_MS=1800000
# Where thread→session ids are stored, for resuming after a restart.
SESSION_STATE_PATH=./.state/sessions.json
# Where schedule records (and their Grants — ADR 0004) are stored, so
# schedules survive a restart.
SCHEDULE_STATE_PATH=./.state/schedules.json
# Central Skill folder (ADR 0005). Drop Claude-Code-standard skill folders
# (<name>/SKILL.md) in here and the next task/run picks them up — no restart.
SKILLS_DIR=./skills
# Chrome profile the agent's browser uses (ADR 0003). Log in to sites here once
# (npm run browser:login) and every task reuses those sessions. Holds real
# credentials — keep it out of git and out of backups you share.
BROWSER_PROFILE_DIR=./.state/browser-profile
